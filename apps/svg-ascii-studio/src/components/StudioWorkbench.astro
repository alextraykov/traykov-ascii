<!--
  SVG → 3D ASCII studio (round 3, picks batch 3). The render engine (studio.js) reads the data-*
  hooks below; studio-ui.js only draws the step strip, the cell tracks over the real range inputs,
  the drop zone's cell icon and drag-over state, the colour swatches (radios that write into the
  native colour inputs) and the export working/done ladder.
-->
<main class="studio2" data-studio data-view="ascii" data-source-state="empty">
  <header class="s2-head">
    <a class="s2-back" href="/labs/">← Labs</a>
    <div class="s2-title">
      <h1>SVG → 3D ASCII</h1>
      <p>Turn a logo into a spinning ASCII object.</p>
    </div>
    <ol class="s2-steps" aria-label="Progress" data-s2-steps>
      <li data-s2-step="add"><i class="s2-cell" aria-hidden="true"></i>1 Add a mark</li>
      <li data-s2-step="look"><i class="s2-cell" aria-hidden="true"></i>2 Choose a look</li>
      <li data-s2-step="export"><i class="s2-cell" aria-hidden="true"></i>3 Export</li>
    </ol>
  </header>

  <section class="s2-card" aria-label="Preview">
    <div class="s2-bar">
      <span class="s2-file" data-source-name>No mark yet</span>
      <div class="s2-bar-actions">
        <div class="s2-seg" role="group" aria-label="View">
          <button class="is-active" type="button" data-view-mode="ascii" aria-pressed="true">ASCII</button>
          <button type="button" data-view-mode="solid" aria-pressed="false">3D</button>
          <button type="button" data-view-mode="both" aria-pressed="false">Both</button>
        </div>
        <button class="s2-quiet" type="button" data-toggle-pause>Pause</button>
        <button class="s2-quiet" type="button" data-fullscreen-stage>Full screen</button>
      </div>
    </div>

    <div class="stage-frame s2-stage" data-stage>
      <div class="solid-preview" data-render-host aria-hidden="true"></div>
      <pre class="ascii-preview" data-ascii-output aria-label="ASCII turntable output"></pre>
      <div class="stage-empty s2-empty" data-stage-empty data-stage-drop-target>
        <div class="s2-drop">
          <i class="s2-upload" aria-hidden="true"></i>
          <b class="s2-empty-title">Drop an SVG here</b>
          <button class="s2-link" type="button" data-stage-browse>or choose a file</button>
          <p class="s2-drop-hint">SVG files only. Filled shapes work best.</p>
        </div>
        <strong class="s2-engine-copy"></strong>
        <span class="s2-engine-copy"></span>
        <div class="s2-samples" role="group" aria-label="Sample marks">
          <p>Or try a sample</p>
          <button type="button" data-load-sample="mark" aria-pressed="false">Mark</button>
          <button type="button" data-load-sample="badge" aria-pressed="false">Badge</button>
          <button type="button" data-load-sample="spark" aria-pressed="false">Spark</button>
        </div>
        <details class="s2-paste">
          <summary>Paste SVG code instead</summary>
          <textarea data-svg-paste spellcheck="false" aria-label="SVG code" placeholder="<svg viewBox=&quot;0 0 320 320&quot;>…</svg>"></textarea>
          <button type="button" data-load-paste>Use this code</button>
        </details>
      </div>
    </div>

    <div class="s2-under">
      <p class="s2-status" data-status aria-live="polite">Add a mark to begin.</p>
      <div class="s2-source-actions">
        <label class="s2-replace" data-dropzone>
          Replace mark
          <input type="file" accept=".svg,image/svg+xml" data-file-input />
        </label>
        <button class="s2-quiet" type="button" data-clear-source>Start over</button>
      </div>
    </div>
  </section>

  <section class="s2-step" aria-labelledby="s2-look-title">
    <div class="s2-step-head">
      <h2 id="s2-look-title">Choose a look</h2>
      <button class="s2-quiet" type="button" data-reset-preset>Reset look</button>
    </div>
    <div class="s2-looks">
      <button class="preset-card is-active" type="button" data-preset="clean"><strong>Clean logo</strong><span>Sharp silhouette, light dither</span></button>
      <button class="preset-card" type="button" data-preset="dense"><strong>Dense print</strong><span>Heavier glyphs, fine tones</span></button>
      <button class="preset-card" type="button" data-preset="wire"><strong>Wireframe</strong><span>Line texture for outlines</span></button>
      <button class="preset-card" type="button" data-preset="crt"><strong>CRT dither</strong><span>Ordered grain with a soft glow</span></button>
      <button class="preset-card" type="button" data-preset="poster"><strong>Poster halftone</strong><span>High contrast, chunky texture</span></button>
      <button class="preset-card" type="button" data-preset="binary"><strong>Binary mark</strong><span>Only 0 and 1</span></button>
    </div>
    <p class="s2-meta" data-preset-status>Clean logo active</p>

    <details class="s2-adjust">
      <summary>Adjust</summary>
      <div class="s2-sliders">
        <label><span>Character size <output data-output="density">9</output></span><input type="range" min="4" max="22" step="1" value="9" data-control="density" /></label>
        <label><span>Contrast <output data-output="contrast">1.35</output></span><input type="range" min="0.35" max="3.4" step="0.01" value="1.35" data-control="contrast" /></label>
        <label><span>Depth <output data-output="depth">60</output></span><input type="range" min="4" max="160" step="1" value="60" data-control="depth" /></label>
        <label><span>Spin <output data-output="speed">0.28</output></span><input type="range" min="0" max="1.2" step="0.01" value="0.28" data-control="speed" /></label>
        <label><span>Size <output data-output="objectScale">1.00</output></span><input type="range" min="0.35" max="2.2" step="0.01" value="1" data-control="objectScale" /></label>
        <label><span>Texture <output data-output="ditherStrength">0.16</output></span><input type="range" min="0" max="0.55" step="0.01" value="0.16" data-control="ditherStrength" /></label>
      </div>

      <details class="s2-more">
        <summary>More controls</summary>
        <div class="s2-groups">
          <fieldset>
            <legend>Characters</legend>
            <label><span>Rows <output data-output="rowScale">1.55</output></span><input type="range" min="1" max="2.4" step="0.01" value="1.55" data-control="rowScale" /></label>
            <label><span>Brightness <output data-output="brightness">0.00</output></span><input type="range" min="-0.35" max="0.35" step="0.01" value="0" data-control="brightness" /></label>
            <label><span>Cut-off <output data-output="threshold">0.965</output></span><input type="range" min="0.7" max="0.995" step="0.001" value="0.965" data-control="threshold" /></label>
            <label><span>Character set size <output data-output="glyphDetail">8</output></span><input type="range" min="2" max="12" step="1" value="8" data-control="glyphDetail" /></label>
            <label class="s2-select"><span>Grain</span><select data-control="ditherMode"><option value="none">None</option><option value="bayer2">Fine grid</option><option value="bayer4" selected>Grid</option><option value="noise">Noise</option></select></label>
            <label class="s2-select"><span>Characters</span><select data-control="ramp"><option value="classic" selected>Classic</option><option value="dense">Dense</option><option value="wire">Wire</option><option value="binary">Binary</option></select></label>
            <label><span>Glow <output data-output="glow">0.18</output></span><input type="range" min="0" max="1.2" step="0.01" value="0.18" data-control="glow" /></label>
            <label class="s2-check"><input type="checkbox" data-control="invert" /><span>Invert</span></label>
          </fieldset>
          <fieldset>
            <legend>Shape</legend>
            <label><span>Bevel <output data-output="bevel">4.0</output></span><input type="range" min="0" max="16" step="0.1" value="4" data-control="bevel" /></label>
            <label><span>Curve smoothness <output data-output="curveSegments">32</output></span><input type="range" min="8" max="80" step="1" value="32" data-control="curveSegments" /></label>
          </fieldset>
          <fieldset>
            <legend>Angle and camera</legend>
            <label><span>Tilt <output data-output="rotationX">-0.18</output></span><input type="range" min="-1.4" max="1.4" step="0.01" value="-0.18" data-control="rotationX" /></label>
            <label><span>Turn <output data-output="rotationY">0.00</output></span><input type="range" min="-3.14" max="3.14" step="0.01" value="0" data-control="rotationY" /></label>
            <label><span>Lean <output data-output="rotationZ">-0.06</output></span><input type="range" min="-1.2" max="1.2" step="0.01" value="-0.06" data-control="rotationZ" /></label>
            <label><span>Wobble <output data-output="wobble">0.02</output></span><input type="range" min="0" max="0.18" step="0.01" value="0.02" data-control="wobble" /></label>
            <label><span>Distance <output data-output="cameraDistance">8.4</output></span><input type="range" min="4" max="14" step="0.1" value="8.4" data-control="cameraDistance" /></label>
            <label><span>Lens <output data-output="fov">34</output></span><input type="range" min="16" max="72" step="1" value="34" data-control="fov" /></label>
          </fieldset>
          <fieldset>
            <legend>Colour and material</legend>
            <div class="s2-colors">
              <div class="s2-swatch-row" data-swatches="frontColor">
                <span class="s2-swatch-name" id="s2-swatch-frontColor">Face</span>
                <div class="s2-swatches" role="radiogroup" aria-labelledby="s2-swatch-frontColor" hidden></div>
                <label class="s2-other"><input type="color" value="#080808" data-control="frontColor" /><span>Other<span class="s2-vh"> face colour</span>…</span></label>
              </div>
              <div class="s2-swatch-row" data-swatches="sideColor">
                <span class="s2-swatch-name" id="s2-swatch-sideColor">Sides</span>
                <div class="s2-swatches" role="radiogroup" aria-labelledby="s2-swatch-sideColor" hidden></div>
                <label class="s2-other"><input type="color" value="#747064" data-control="sideColor" /><span>Other<span class="s2-vh"> sides colour</span>…</span></label>
              </div>
              <div class="s2-swatch-row" data-swatches="backgroundColor">
                <span class="s2-swatch-name" id="s2-swatch-backgroundColor">Ground</span>
                <div class="s2-swatches" role="radiogroup" aria-labelledby="s2-swatch-backgroundColor" hidden></div>
                <label class="s2-other"><input type="color" value="#fbfbf8" data-control="backgroundColor" /><span>Other<span class="s2-vh"> ground colour</span>…</span></label>
              </div>
            </div>
            <label><span>Shine <output data-output="metalness">0.08</output></span><input type="range" min="0" max="1" step="0.01" value="0.08" data-control="metalness" /></label>
            <label><span>Roughness <output data-output="roughness">0.42</output></span><input type="range" min="0.05" max="1" step="0.01" value="0.42" data-control="roughness" /></label>
          </fieldset>
          <fieldset>
            <legend>Light</legend>
            <label><span>Ambient <output data-output="ambient">0.88</output></span><input type="range" min="0" max="2" step="0.01" value="0.88" data-control="ambient" /></label>
            <label><span>Key <output data-output="key">4.8</output></span><input type="range" min="0" max="8" step="0.1" value="4.8" data-control="key" /></label>
            <label><span>Rim <output data-output="rim">3.2</output></span><input type="range" min="0" max="8" step="0.1" value="3.2" data-control="rim" /></label>
            <label><span>Fill <output data-output="fill">2.1</output></span><input type="range" min="0" max="8" step="0.1" value="2.1" data-control="fill" /></label>
          </fieldset>
          <fieldset>
            <legend>Pointer</legend>
            <label><span>Hover glow <output data-output="hover">0.32</output></span><input type="range" min="0" max="1.2" step="0.01" value="0.32" data-control="hover" /></label>
            <label><span>Trail length <output data-output="trailDecay">520</output></span><input type="range" min="120" max="1800" step="10" value="520" data-control="trailDecay" /></label>
            <label><span>Click burst <output data-output="clickBoost">1.20</output></span><input type="range" min="0" max="3" step="0.05" value="1.2" data-control="clickBoost" /></label>
          </fieldset>
        </div>
      </details>
    </details>
  </section>

  <section class="s2-step s2-export" aria-labelledby="s2-export-title">
    <div class="s2-step-head"><h2 id="s2-export-title">Export</h2></div>
    <div class="s2-export-main">
      <button class="s2-primary" type="button" data-download-png data-export-requires-valid disabled>Download PNG</button>
      <button type="button" data-copy-ascii data-export-requires-valid disabled>Copy ASCII</button>
      <label class="s2-inline"><span>PNG size <b class="s2-val"><output data-output="exportScale">2.00</output>×</b></span><input type="range" min="1" max="4" step="0.25" value="2" data-control="exportScale" /></label>
      <label class="s2-check"><input type="checkbox" data-control="includeAttribution" checked /><span>Credit the studio in the image</span></label>
    </div>
    <details class="s2-more">
      <summary>More formats</summary>
      <div class="s2-formats">
        <button type="button" data-download-ascii data-export-requires-valid disabled>Text file</button>
        <button type="button" data-download-svg data-export-requires-valid disabled>SVG</button>
        <button type="button" data-download-settings data-export-requires-valid disabled>Settings file</button>
        <button type="button" data-copy-settings data-export-requires-valid disabled>Copy settings</button>
        <button type="button" data-copy-code data-export-requires-valid disabled>Copy Three.js code</button>
        <button type="button" data-download-code data-export-requires-valid disabled>Download Three.js code</button>
      </div>
      <div class="s2-share">
        <p data-share-copy>Made a 3D ASCII turntable in Alexander Traykov's ASCII Studio.</p>
        <button type="button" data-copy-share data-export-requires-valid disabled>Copy share text</button>
        <button type="button" data-copy-share-url data-export-requires-valid disabled>Copy studio link</button>
        <button type="button" data-share-twitter data-export-requires-valid disabled>Post on X</button>
      </div>
      <div class="s2-code">
        <label><span>Settings</span><textarea data-settings-output readonly spellcheck="false"></textarea></label>
        <label><span>Three.js code</span><textarea data-code-output readonly spellcheck="false"></textarea></label>
      </div>
    </details>
  </section>

  <details class="s2-step s2-about">
    <summary>About this file</summary>
    <div class="s2-about-body">
      <div class="s2-original" data-svg-preview><span>No SVG loaded</span></div>
      <dl>
        <div><dt>Cleaned</dt><dd data-diagnostic="security">No active SVG</dd></div>
        <div><dt>Shapes</dt><dd data-diagnostic="geometry">No mesh generated</dd></div>
        <div><dt>Load</dt><dd data-diagnostic="performance">Ready</dd></div>
      </dl>
      <p>Masks, filters, images and complex gradients are ignored. Scripts and unsafe links inside the SVG are removed before anything is drawn.</p>
    </div>
  </details>
</main>

<script>
  import "../scripts/studio.js";
  import "../scripts/studio-ui.js";
</script>
