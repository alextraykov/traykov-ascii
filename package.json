{
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sketches": "astro dev --open /labs/sketchbook/",
    "build": "astro build && node scripts/build-private-work.mjs",
    "preview": "astro preview",
    "export:blocktype-wave": "node scripts/export-blocktype-wave-video.mjs",
    "package:glyph-kit": "node scripts/package-glyph-kit.mjs",
    "smoke:product-kit": "node scripts/product-systems-kit-smoke.mjs",
    "verify": "node scripts/verify-site.mjs && node --test tests/contact-api.test.mjs tests/local-image-dimensions.test.mjs tests/private-work.test.mjs tests/glyph-kit-draw.test.mjs",
    "check:fast": "npm run verify && npm run build",
    "check:browser": "node scripts/run-browser-check.mjs scripts/browser-contract.mjs",
    "check": "npm run check:fast && npm run check:browser",
    "test:private-work": "node --test tests/private-work.test.mjs",
    "check:private-work": "npm run build && node scripts/private-work-browser.mjs",
    "check:presenting-in-code": "npm run build && node scripts/run-browser-check.mjs scripts/presenting-in-code-browser.mjs",
    "audit:visual": "node scripts/run-browser-check.mjs scripts/visual-audit.mjs",
    "audit:routes": "node scripts/run-browser-check.mjs scripts/route-audit.mjs",
    "audit:performance": "node scripts/run-browser-check.mjs scripts/performance-audit.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@vercel/analytics": "^2.0.1",
    "astro": "^6.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
