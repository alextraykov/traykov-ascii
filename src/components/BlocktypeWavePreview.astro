<figure
  class="note-wave-preview"
  data-blocktype-wave-preview
  data-seed="25502"
  aria-label="Interactive blocktype wave study"
>
  <canvas
    width="1280"
    height="720"
    role="img"
    aria-label="Animated trochoidal waves rendered with blank, light, medium, and heavy blocktype glyphs."
  ></canvas>
</figure>

<script>
  import { createSketch } from "../sketches/blocktype-dither.js";

  const PRESET = Object.freeze({
    pitch: 8,
    waveScale: 1.15,
    amplitude: 1.25,
    steepness: 0.59,
    speed: 0.45,
    contrast: 0.85
  });

  const initializeWavePreview = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

    const canvas = root.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext("2d", { alpha: false });
    if (!context) return;

    root.dataset.ready = "true";

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pointer = {
      x: 0.5,
      y: 0.5,
      inside: false
    };
    const seed = Number(root.dataset.seed) || 25502;
    const sketch = createSketch({
      canvas,
      context,
      params: { ...PRESET },
      pointer,
      seed,
      setStatus() {}
    });

    let width = 1;
    let height = 1;
    let dpr = 1;
    let elapsed = 0;
    let lastTimestamp = 0;
    let frameHandle = 0;
    let visible = false;
    let destroyed = false;

    const shouldAnimate = () =>
      visible && !reducedMotion.matches && !document.hidden && !destroyed;

    const render = (timestamp: number) => {
      frameHandle = 0;
      const delta = lastTimestamp
        ? Math.min(0.1, (timestamp - lastTimestamp) / 1000)
        : 0;

      lastTimestamp = timestamp;
      if (!reducedMotion.matches) elapsed += delta;
      sketch.frame?.({ time: elapsed, delta, width, height, dpr });

      if (shouldAnimate()) frameHandle = window.requestAnimationFrame(render);
    };

    const requestFrame = () => {
      if (!frameHandle && !document.hidden && !destroyed) {
        frameHandle = window.requestAnimationFrame(render);
      }
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
      sketch.resize?.({ width, height, dpr });
      lastTimestamp = 0;
      requestFrame();
    };

    const updatePointer = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = Math.min(
        1,
        Math.max(0, (event.clientX - rect.left) / Math.max(1, rect.width))
      );
      pointer.y = Math.min(
        1,
        Math.max(0, (event.clientY - rect.top) / Math.max(1, rect.height))
      );
      pointer.inside = true;
      requestFrame();
    };

  const resizeObserver = new ResizeObserver(resize);
    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        lastTimestamp = 0;

        if (visible) requestFrame();
      },
      { rootMargin: "120px 0px" }
    );

    canvas.addEventListener("pointermove", updatePointer);
    canvas.addEventListener("pointerenter", updatePointer);
  canvas.addEventListener("pointerleave", () => {
    pointer.inside = false;
    requestFrame();
  });
  document.addEventListener("visibilitychange", () => {
      lastTimestamp = 0;
      if (!document.hidden && visible) requestFrame();
    });
    reducedMotion.addEventListener("change", () => {
      lastTimestamp = 0;
      requestFrame();
    });

    const destroy = () => {
      if (destroyed) return;
      destroyed = true;
    window.cancelAnimationFrame(frameHandle);
    resizeObserver.disconnect();
    intersectionObserver.disconnect();
    sketch.destroy?.();
  };

    window.addEventListener("pagehide", destroy, { once: true });
    resizeObserver.observe(canvas);
    intersectionObserver.observe(canvas);
    resize();
  };

  document
    .querySelectorAll("[data-blocktype-wave-preview]")
    .forEach(initializeWavePreview);
</script>
