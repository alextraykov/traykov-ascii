---
interface Props {
  caseTitle: string;
  title: string;
  body: string;
  compact?: boolean;
}

const { caseTitle, title, body, compact = false } = Astro.props;
const emailHref = `mailto:hi@traykov.cc?subject=${encodeURIComponent(`Product question after reading ${caseTitle}`)}`;
const defaultBookingUrl = "https://cal.com/alexander-cqn5aq/30min";
const configuredBookingUrl =
  import.meta.env.PUBLIC_CAL_BOOKING_URL ??
  import.meta.env.PUBLIC_BOOKING_URL ??
  defaultBookingUrl;
const bookingPageUrl = (() => {
  try {
    const url = new URL(configuredBookingUrl);
    return ["https:", "http:"].includes(url.protocol) ? url.toString() : defaultBookingUrl;
  } catch {
    return defaultBookingUrl;
  }
})();
---

<aside
  class:list={["case-contact-prompt", { "case-contact-prompt--compact": compact }]}
  aria-labelledby="case-contact-title"
  data-reveal={compact ? undefined : "rise"}
>
  <div class="case-contact-prompt__copy">
    <h2 id="case-contact-title">{title}</h2>
    {body && <p>{body}</p>}
  </div>

  <div class="case-contact-prompt__actions">
    <a
      href={bookingPageUrl}
      data-booking-modal-open
      data-ascii-action="primary"
      data-ascii-stream={compact ? undefined : true}
      data-ascii-burst={compact ? undefined : true}
    >
      {compact ? "Book 30 minutes" : <span>Book 30 minutes</span>}
    </a>
    {!compact && <a href={emailHref} data-ascii-action="text" data-ascii-burst>Email instead</a>}
  </div>
</aside>
