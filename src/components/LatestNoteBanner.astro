---
import { getNotes } from "../lib/substack";

const [latest] = await getNotes();
const published = latest
  ? new Intl.DateTimeFormat("en", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      timeZone: "Europe/Sofia"
    }).format(new Date(latest.publishedAt))
  : "";
// Enough copies that one group is always wider than the widest screen.
const copies = Array.from({ length: 6 });
---

{latest && (
  <div class="latest-note-banner" data-latest-note-banner={latest.slug}>
    <a
      class="latest-note-banner__link"
      href={`/notes/${latest.slug}/`}
      aria-label={`Latest note: ${latest.title}, ${published}`}
    >
      <span class="latest-note-banner__track" aria-hidden="true">
        {[0, 1].map(() => (
          <span class="latest-note-banner__group">
            {copies.map(() => (
              <span class="latest-note-banner__item">
                <span>Latest note</span>
                <span>—</span>
                <span class="latest-note-banner__title">{latest.title}</span>
                <span>—</span>
                <time datetime={latest.publishedAt}>{published}</time>
                <span class="latest-note-banner__rule">░▒▓</span>
              </span>
            ))}
          </span>
        ))}
      </span>
    </a>
    <button type="button" class="latest-note-banner__close" data-latest-note-close>
      Close
    </button>
  </div>
)}

<script is:inline>
  // Closing hides the banner until a newer note comes out. Runs before paint so it never flashes.
  (() => {
    const banner = document.querySelector("[data-latest-note-banner]");
    if (!banner) return;
    const key = "latest-note-closed";
    try {
      if (window.localStorage.getItem(key) === banner.dataset.latestNoteBanner) banner.hidden = true;
    } catch {}
    banner.querySelector("[data-latest-note-close]")?.addEventListener("click", () => {
      banner.hidden = true;
      try {
        window.localStorage.setItem(key, banner.dataset.latestNoteBanner);
      } catch {}
    });
  })();
</script>
