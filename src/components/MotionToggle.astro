---
// The one global motion control (WCAG 2.2.2: anything that moves longer than 5s can be stopped).
// Round 3: it lives in the footer's Settings column, or in the nav bar on full-screen tool pages
// that have no footer. Exactly one per page. lifecycle.js drives its state and labels.
// Picks (B, static): "Motion", a 2-cell switch (8·8 on, 0·0 off, dotted frame when the system
// reduces motion) and the state word. Nothing on it is animated or blinks.
type Props = { variant?: "footer" | "nav" };
const { variant = "footer" }: Props = Astro.props;
---

<button
  class:list={["motion-toggle", `motion-toggle--${variant}`]}
  type="button"
  hidden
  aria-label="Motion"
  aria-describedby="motion-toggle-description"
  aria-pressed="true"
  data-motion-toggle
>
  <span class="motion-toggle__name" aria-hidden="true">MOTION</span>
  <span class="motion-toggle__switch cells" aria-hidden="true"><i class="cell" data-level="8"></i><i class="cell" data-level="8"></i></span>
  <span class="motion-toggle__state" aria-hidden="true" data-motion-toggle-state>ON</span>
  <span class="visually-hidden" id="motion-toggle-description" data-motion-toggle-description>Motion is on</span>
</button>
