<figure
  class="note-pace"
  data-price-of-pace
  data-seed="2026"
>
  <canvas
    width="1280"
    height="720"
    role="img"
    aria-label="A turning loop drawn in light, medium and heavy block characters. The faster it turns, the more of its rows slip sideways or show an older copy of itself."
  ></canvas>
</figure>

<script>
  import { createSketch } from "../sketches/price-of-pace.js";
  import { isMotionActive, onMotionChange } from "../scripts/motion/lifecycle.js";

  const initializePace = (root: Element) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

    const canvas = root.querySelector("canvas");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext("2d", { alpha: false });
    if (!context) return;

    root.dataset.ready = "true";

    const pointer = { x: 0.72, y: 0.5, inside: false };
    let sketch: ReturnType<typeof createSketch>;
    try {
      sketch = createSketch({
        canvas,
        context,
        pointer,
        seed: Number(root.dataset.seed) || 2026
      });
    } catch {
      root.hidden = true;
      return;
    }

    let width = 1;
    let height = 1;
    let dpr = 1;
    let elapsed = 0;
    let lastTimestamp = 0;
    let frameHandle = 0;
    let visible = false;
    let destroyed = false;

    const canRender = () => visible && !document.hidden && !destroyed;
    const shouldAnimate = () => canRender() && isMotionActive();

    const render = (timestamp: number) => {
      frameHandle = 0;
      const animate = shouldAnimate();
      const delta = animate && lastTimestamp
        ? Math.min(0.1, (timestamp - lastTimestamp) / 1000)
        : 0;

      lastTimestamp = timestamp;
      if (animate) elapsed += delta;
      sketch.frame({ time: elapsed, delta });

      if (shouldAnimate()) frameHandle = window.requestAnimationFrame(render);
    };

    const requestFrame = () => {
      if (!frameHandle && canRender()) {
        frameHandle = window.requestAnimationFrame(render);
      }
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(width * dpr));
      canvas.height = Math.max(1, Math.round(height * dpr));
      sketch.resize({ width, height, dpr });
      lastTimestamp = 0;
      requestFrame();
    };

    const updatePointer = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = Math.min(1, Math.max(0, (event.clientX - rect.left) / Math.max(1, rect.width)));
      pointer.y = Math.min(1, Math.max(0, (event.clientY - rect.top) / Math.max(1, rect.height)));
      pointer.inside = true;
      requestFrame();
    };
    const handlePointerLeave = () => {
      pointer.inside = false;
      requestFrame();
    };
    const handleVisibilityChange = () => {
      lastTimestamp = 0;
      if (!document.hidden && visible) requestFrame();
    };

    const resizeObserver = new ResizeObserver(resize);
    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting);
        lastTimestamp = 0;

        if (!visible && frameHandle) {
          window.cancelAnimationFrame(frameHandle);
          frameHandle = 0;
        }
        if (visible) requestFrame();
      },
      { rootMargin: "120px 0px" }
    );
    const unsubscribeMotion = onMotionChange(() => {
      lastTimestamp = 0;
      if (!isMotionActive() && frameHandle) {
        window.cancelAnimationFrame(frameHandle);
        frameHandle = 0;
      }
      requestFrame();
    });

    const destroy = () => {
      if (destroyed) return;
      destroyed = true;
      window.cancelAnimationFrame(frameHandle);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      unsubscribeMotion();
      canvas.removeEventListener("pointermove", updatePointer);
      canvas.removeEventListener("pointerenter", updatePointer);
      canvas.removeEventListener("pointerleave", handlePointerLeave);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
      window.removeEventListener("pagehide", handlePageHide);
      window.removeEventListener("pageshow", handlePageShow);
      sketch.destroy();
    };
    const handlePageHide = (event: PageTransitionEvent) => {
      if (event.persisted) {
        if (frameHandle) window.cancelAnimationFrame(frameHandle);
        frameHandle = 0;
        return;
      }
      destroy();
    };
    const handlePageShow = (event: PageTransitionEvent) => {
      if (!event.persisted) return;
      lastTimestamp = 0;
      if (visible) requestFrame();
    };

    canvas.addEventListener("pointermove", updatePointer);
    canvas.addEventListener("pointerenter", updatePointer);
    canvas.addEventListener("pointerleave", handlePointerLeave);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    window.addEventListener("pagehide", handlePageHide);
    window.addEventListener("pageshow", handlePageShow);
    resizeObserver.observe(canvas);
    intersectionObserver.observe(canvas);
    resize();
  };

  document.querySelectorAll("[data-price-of-pace]").forEach(initializePace);
</script>
