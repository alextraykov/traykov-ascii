---
import MotionToggle from "./MotionToggle.astro";

type FooterLink = {
  label: string;
  href: string;
};

const { omitBookingEmbed = false } = Astro.props;

const defaultBookingUrl = "https://cal.com/alexander-cqn5aq/30min";
const bookingUrl =
  import.meta.env.PUBLIC_CAL_BOOKING_URL ??
  import.meta.env.PUBLIC_BOOKING_URL ??
  defaultBookingUrl;

const siteLinks: FooterLink[] = [
  { label: "Work", href: "/#work" },
  { label: "Notes", href: "/notes/" },
  { label: "Labs", href: "/labs/" },
  { label: "About", href: "/about/" }
];

const feedLinks: FooterLink[] = [
  { label: "RSS", href: "/rss.xml" },
  { label: "For machines", href: "/llms.txt" }
];

const bookingPageUrl = (() => {
  try {
    const url = new URL(bookingUrl);
    return ["https:", "http:"].includes(url.protocol) ? url.toString() : defaultBookingUrl;
  } catch {
    return defaultBookingUrl;
  }
})();

const bookingEmbedUrl = (() => {
  const url = new URL(bookingPageUrl);
  const isCalBooking =
    url.hostname === "cal.com" &&
    url.pathname.split("/").filter(Boolean).length >= 2;
  if (!isCalBooking) return undefined;

  url.searchParams.set("embed", "true");
  return url.toString();
})();
---

<footer class="site-footer">
  <div class="site-footer__inner section-shell">
    <div class="site-footer__columns">
      <nav class="footer-links" aria-label="Footer">
        <h2 class="site-footer__heading">Site</h2>
        {siteLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <nav class="footer-links" aria-label="Contact">
        <h2 class="site-footer__heading">Contact</h2>
        <a href="/contact/">Contact</a>
        <a
          href={bookingPageUrl}
          target="_blank"
          rel="noreferrer"
          data-booking-modal-open={!omitBookingEmbed && bookingEmbedUrl ? "" : undefined}
        >Book a call</a>
        <a href="/cv/">CV</a>
      </nav>
      <nav class="footer-links" aria-label="Feeds">
        <h2 class="site-footer__heading">Feeds</h2>
        {feedLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div class="site-footer__settings">
        <h2 class="site-footer__heading">Settings</h2>
        <button
          class="site-footer__setting"
          type="button"
          data-theme-toggle
          aria-label="Automatic color theme. Activate to switch theme."
        >Theme <i class="site-footer__theme-cell" aria-hidden="true"></i><span class="site-footer__setting-value" data-theme-value>Auto</span></button>
        <MotionToggle variant="footer" />
        <slot name="actions" />
      </div>
    </div>

    <div class="site-footer__base">
      <a class="site-footer__mark" href="/" aria-label="AT — Alexander Traykov home">
        <span class="site-footer__mark-logo" aria-hidden="true"></span>
        <span>Alexander Traykov · Sofia, Bulgaria · 2026</span>
      </a>
      <a class="site-footer__top" href="#top" aria-label="Back to top" data-back-to-top>
        <span class="cells site-footer__progress" aria-hidden="true" data-back-to-top-cells></span>
        <span>Back to top<span class="site-footer__pct" aria-hidden="true" data-back-to-top-pct></span></span>
      </a>
    </div>
  </div>

  {!omitBookingEmbed && bookingEmbedUrl && (
    <dialog class="footer-booking-modal" aria-labelledby="footer-booking-modal-title" data-footer-booking-modal>
      <div class="footer-booking-modal__header">
        <div>
          <p class="footer-booking-modal__kicker" aria-hidden="true">Booking</p>
          <h2 id="footer-booking-modal-title">Pick a time that works.</h2>
        </div>
        <button
          type="button"
          class="footer-booking-modal__close"
          aria-label="Close booking calendar"
          data-footer-booking-close
        >
          <span data-cell-icon="close" aria-hidden="true">×</span>
        </button>
      </div>
      <div class="footer-booking__body">
        <iframe
          class="footer-booking__frame"
          src={bookingEmbedUrl}
          title="Book a 30-minute call with Alexander Traykov"
          loading="lazy"
          allow="payment"
        ></iframe>
        <p class="footer-booking__fallback">
          If the calendar does not load,
          <a href={bookingPageUrl} target="_blank" rel="noreferrer">open the booking page ↗</a>
        </p>
      </div>
    </dialog>
  )}
</footer>

<script>
  import "../scripts/motion/index.js";
  import { createCells, createIcon, runField, setLevel } from "../scripts/motion/cells.js";
  import { isMotionActive } from "../scripts/motion/lifecycle.js";

  // Back to top (picks, A): one 6 × 16 cell whose level is how far down the page you are (0–8).
  // A pointer click empties it in 8 steps of 30 ms while the page returns; Enter empties it at once.
  document.querySelectorAll("[data-back-to-top-cells]").forEach((host) => {
    if (!(host instanceof HTMLElement) || host.dataset.ready === "true") return;
    host.dataset.ready = "true";
    host.style.setProperty("--cells", "1");
    const [cell] = createCells(host, 1);
    const link = host.closest("[data-back-to-top]");
    let frame = 0;
    let returning = false;
    let stop = () => {};
    const paint = () => {
      frame = 0;
      if (returning) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      setLevel(cell, Math.round(progress * 8));
    };
    window.addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(paint); }, { passive: true });
    link?.addEventListener("click", (event) => {
      stop();
      if (!(event instanceof MouseEvent) || event.detail === 0 || !isMotionActive()) {
        setLevel(cell, 0);
        return;
      }
      const from = Number(cell.dataset.level || 0);
      returning = true;
      stop = runField({
        values: [0],
        total: 0,
        steps: 8,
        stepMs: 30,
        render: (stepAt) => {
          const at = stepAt(0);
          if (at >= 0) setLevel(cell, from * (1 - Math.min(8, at + 1) / 8));
        },
        done: () => {
          returning = false;
          paint();
        }
      });
    });
    paint();
  });

  // Dialog motion (picks, B): a pointer open switches the panel on from a 2 px line at its centre in
  // four steps over 240 ms; a pointer close leaves with the 180 ms afterglow while focus returns at
  // once. Keyboard opens, Escape, backdrop clicks and motion off are instant.
  const openDialog = (dialog: HTMLDialogElement, event: Event) => {
    const quick = !(event instanceof MouseEvent) || event.detail === 0 || !isMotionActive();
    dialog.classList.remove("is-instant", "is-opening");
    if (!quick) {
      dialog.classList.add("is-opening");
      dialog.addEventListener("animationend", () => dialog.classList.remove("is-opening"), { once: true });
    }
    dialog.showModal();
  };
  const closeDialog = (dialog: HTMLDialogElement, instant: boolean) => {
    dialog.classList.remove("is-opening");
    dialog.classList.toggle("is-instant", instant || !isMotionActive());
    dialog.close();
  };

  document.querySelectorAll("[data-footer-booking-modal]").forEach((modal) => {
    if (!(modal instanceof HTMLDialogElement) || modal.dataset.bookingReady === "true") return;

    const closeButton = modal.querySelector("[data-footer-booking-close]");
    if (!(closeButton instanceof HTMLButtonElement)) return;

    modal.dataset.bookingReady = "true";
    closeButton.querySelectorAll<HTMLElement>("[data-cell-icon]").forEach((icon) => {
      createIcon(icon, icon.dataset.cellIcon || "close", { cell: 3 });
    });
    let activeTrigger: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>("[data-booking-modal-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        activeTrigger = trigger;
        openDialog(modal, event);
      });
    });
    closeButton.addEventListener("click", (event) => closeDialog(modal, event.detail === 0));
    modal.addEventListener("cancel", () => modal.classList.add("is-instant"));
    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeDialog(modal, true);
    });
    modal.addEventListener("close", () => activeTrigger?.focus());
  });
</script>
