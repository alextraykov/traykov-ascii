---
import MotionToggle from "./MotionToggle.astro";

type FooterLink = {
  label: string;
  href: string;
};

const { omitBookingEmbed = false } = Astro.props;

const defaultBookingUrl = "https://cal.com/alexander-cqn5aq/30min";
const bookingUrl =
  import.meta.env.PUBLIC_CAL_BOOKING_URL ??
  import.meta.env.PUBLIC_BOOKING_URL ??
  defaultBookingUrl;

const siteLinks: FooterLink[] = [
  { label: "Work", href: "/#work" },
  { label: "Notes", href: "/notes/" },
  { label: "Labs", href: "/labs/" },
  { label: "About", href: "/about/" }
];

const feedLinks: FooterLink[] = [
  { label: "RSS", href: "/rss.xml" },
  { label: "For machines", href: "/llms.txt" }
];

const bookingPageUrl = (() => {
  try {
    const url = new URL(bookingUrl);
    return ["https:", "http:"].includes(url.protocol) ? url.toString() : defaultBookingUrl;
  } catch {
    return defaultBookingUrl;
  }
})();

const bookingEmbedUrl = (() => {
  const url = new URL(bookingPageUrl);
  const isCalBooking =
    url.hostname === "cal.com" &&
    url.pathname.split("/").filter(Boolean).length >= 2;
  if (!isCalBooking) return undefined;

  url.searchParams.set("embed", "true");
  return url.toString();
})();
---

<footer class="site-footer">
  <div class="site-footer__inner section-shell">
    <div class="site-footer__columns">
      <nav class="footer-links" aria-label="Footer">
        <h2 class="site-footer__heading">Site</h2>
        {siteLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <nav class="footer-links" aria-label="Contact">
        <h2 class="site-footer__heading">Contact</h2>
        <a href="/contact/">Contact</a>
        <a
          href={bookingPageUrl}
          target="_blank"
          rel="noreferrer"
          data-booking-modal-open={!omitBookingEmbed && bookingEmbedUrl ? "" : undefined}
        >Book a call</a>
        <a href="/cv/">CV</a>
      </nav>
      <nav class="footer-links" aria-label="Feeds">
        <h2 class="site-footer__heading">Feeds</h2>
        {feedLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div class="site-footer__settings">
        <h2 class="site-footer__heading">Settings</h2>
        <button
          class="site-footer__setting"
          type="button"
          data-theme-toggle
          aria-label="Automatic color theme. Activate to switch theme."
        >Theme <span class="site-footer__setting-value" data-theme-value>Auto</span></button>
        <MotionToggle variant="footer" />
        <slot name="actions" />
      </div>
    </div>

    <div class="site-footer__base">
      <a class="site-footer__mark" href="/" aria-label="AT — Alexander Traykov home">
        <span class="site-footer__mark-logo" aria-hidden="true"></span>
        <span>Alexander Traykov · Sofia, Bulgaria · 2026</span>
      </a>
      <a class="site-footer__top" href="#top" aria-label="Back to top" data-back-to-top>
        <span class="cells site-footer__progress" aria-hidden="true" data-back-to-top-cells></span>
        <span>Back to top<span class="site-footer__pct" aria-hidden="true" data-back-to-top-pct></span></span>
      </a>
    </div>
  </div>

  {!omitBookingEmbed && bookingEmbedUrl && (
    <dialog class="footer-booking-modal" aria-labelledby="footer-booking-modal-title" data-footer-booking-modal>
      <div class="footer-booking-modal__header">
        <div>
          <h2 id="footer-booking-modal-title">Pick a time that works.</h2>
        </div>
        <button
          type="button"
          class="footer-booking-modal__close"
          aria-label="Close booking calendar"
          data-footer-booking-close
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <div class="footer-booking__body">
        <iframe
          class="footer-booking__frame"
          src={bookingEmbedUrl}
          title="Book a 30-minute call with Alexander Traykov"
          loading="lazy"
          allow="payment"
        ></iframe>
        <p class="footer-booking__fallback">
          If the calendar does not load,
          <a href={bookingPageUrl} target="_blank" rel="noreferrer">open the booking page ↗</a>
        </p>
      </div>
    </dialog>
  )}
</footer>

<script>
  import "../scripts/motion/index.js";
  import { createCells, setLevel } from "../scripts/motion/cells.js";

  // Back to top shows how far down the page you are, as cells.
  document.querySelectorAll("[data-back-to-top-cells]").forEach((host) => {
    if (!(host instanceof HTMLElement) || host.dataset.ready === "true") return;
    host.dataset.ready = "true";
    const count = 16;
    host.style.setProperty("--cells", String(count));
    const cells = createCells(host, count);
    let frame = 0;
    const paint = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(1, window.scrollY / max) : 0;
      cells.forEach((cell, index) => {
        const fill = progress * count - index;
        setLevel(cell, fill >= 1 ? 8 : fill <= 0 ? 0 : Math.ceil(fill * 8));
      });
      const pct = host.closest("[data-back-to-top]")?.querySelector("[data-back-to-top-pct]");
      if (pct) pct.textContent = ` · ${Math.round(progress * 100)}% down`;
    };
    window.addEventListener("scroll", () => { if (!frame) frame = requestAnimationFrame(paint); }, { passive: true });
    paint();
  });

  document.querySelectorAll("[data-footer-booking-modal]").forEach((modal) => {
    if (!(modal instanceof HTMLDialogElement) || modal.dataset.bookingReady === "true") return;

    const closeButton = modal.querySelector("[data-footer-booking-close]");
    if (!(closeButton instanceof HTMLButtonElement)) return;

    modal.dataset.bookingReady = "true";
    let activeTrigger: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>("[data-booking-modal-open]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        activeTrigger = trigger;
        modal.showModal();
      });
    });
    closeButton.addEventListener("click", () => modal.close());
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });
    modal.addEventListener("close", () => activeTrigger?.focus());
  });
</script>
