---
import CaseStudyPage from "../../components/CaseStudyPage.astro";
import { getCaseStudies } from "../../lib/content";
import { getCaseStudyParentId, getFeaturedCaseStudies, isPublicCaseStudy } from "../../lib/public-case-studies";

export function getStaticPaths() {
  const studies = getCaseStudies();
  const featuredStudies = getFeaturedCaseStudies(studies);

  return studies.map((study) => {
    const parentStudyId = getCaseStudyParentId(study.id);
    const parentStudy = parentStudyId ? studies.find((item) => item.id === parentStudyId) : undefined;
    const featuredIndex = featuredStudies.findIndex((item) => item.id === study.id);

    return {
      params: { slug: study.id },
      props: {
        study,
        parentStudy,
        previousStudy: !parentStudy && featuredIndex > 0 ? featuredStudies[featuredIndex - 1] : undefined,
        nextStudy: !parentStudy && featuredIndex >= 0 ? featuredStudies[featuredIndex + 1] : undefined
      }
    };
  });
}

const { study } = Astro.props;
if (!import.meta.env.DEV && !isPublicCaseStudy(study.id)) return Astro.redirect("/#work", 302);
---

<CaseStudyPage {...Astro.props} />
