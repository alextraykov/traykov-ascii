---
import SiteAnalytics from "../components/SiteAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const defaultBookingUrl = "https://cal.com/alexander-cqn5aq/30min";
const configuredBookingUrl =
  import.meta.env.PUBLIC_CAL_BOOKING_URL ??
  import.meta.env.PUBLIC_BOOKING_URL ??
  defaultBookingUrl;
const bookingPageUrl = (() => {
  try {
    const url = new URL(configuredBookingUrl);
    return ["https:", "http:"].includes(url.protocol) ? url.toString() : defaultBookingUrl;
  } catch {
    return defaultBookingUrl;
  }
})();
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Contact Alexander Traykov — AI Product Designer & UX Lead"
      description="Contact Alexander Traykov about AI product design, enterprise UX, design systems, or a focused product-design conversation."
      path="/contact/"
    />
    <script src="/page-transitions.js" defer></script>
    {
      turnstileSiteKey && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        ></script>
      )
    }
  </head>
  <body data-page-type="contact">
    <SiteNav active="contact" />

    <main id="top" class="contact-page">
      <section class="contact-hero section-shell" aria-labelledby="contact-title">
        <div class="contact-hero__copy" data-reveal="rise">
          <p class="section-kicker">Contact</p>
          <h1 id="contact-title">Start with a message.</h1>
          <p>
            It goes to <a href="mailto:hi@traykov.cc">hi@traykov.cc</a>. I usually reply in
            half a day or less.
          </p>
        </div>

        <div class="contact-layout" data-reveal-group>
          <form
            class="contact-form"
            action="/api/contact"
            method="post"
            data-contact-form
            aria-describedby="contact-form-status"
          >
            <div class="contact-form__heading">
              <span>01 / Write</span>
              <h2>Tell me what you’re working on.</h2>
            </div>

            <label>
              <span>Name</span>
              <input
                type="text"
                name="name"
                autocomplete="name"
                maxlength="100"
                required
              />
            </label>

            <label>
              <span>Email</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                maxlength="254"
                required
              />
            </label>

            <label>
              <span>Message</span>
              <textarea
                name="message"
                rows="7"
                minlength="10"
                maxlength="5000"
                required
              ></textarea>
            </label>

            <label class="contact-form__trap" aria-hidden="true">
              <span>Leave this field empty</span>
              <input
                type="text"
                name="website"
                autocomplete="off"
                tabindex="-1"
              />
            </label>

            {
              turnstileSiteKey ? (
                <div class="contact-form__verification">
                  <div
                    class="cf-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-action="contact"
                    data-theme="auto"
                  ></div>
                  <p>Spam check by Cloudflare Turnstile.</p>
                </div>
              ) : (
                <p class="contact-form__configuration">
                  Secure sending is not configured yet. Email{" "}
                  <a href="mailto:hi@traykov.cc">hi@traykov.cc</a> directly.
                </p>
              )
            }

            <p
              id="contact-form-status"
              class="contact-form__status"
              role="status"
              aria-live="polite"
              data-contact-status
            ></p>

            <div class="contact-form__submit">
              <p>Sends directly to my inbox. Your address is only used to reply.</p>
              <button
                type="submit"
                disabled={!turnstileSiteKey}
                data-ascii-action="primary"
                data-ascii-stream
                data-ascii-burst
                data-contact-submit
              >
                <span data-contact-submit-label>Send message</span>
                <span aria-hidden="true">↗</span>
              </button>
            </div>

            <noscript>
              <p class="contact-form__configuration">
                This protected form requires JavaScript. Email{" "}
                <a href="mailto:hi@traykov.cc">hi@traykov.cc</a> instead.
              </p>
            </noscript>
          </form>

          <aside class="contact-call" aria-labelledby="contact-call-title">
            <span>02 / Talk</span>
            <div>
              <h2 id="contact-call-title">Book a call</h2>
              <p>Thirty minutes. No pitch, no pressure.</p>
            </div>
            <a
              id="book-a-call"
              href={bookingPageUrl}
              data-booking-modal-open
              data-ascii-action="inverse"
              data-ascii-stream
              data-ascii-burst
            >
              <span data-scramble data-scramble-label="Book a call">Book a call</span>
              <span aria-hidden="true">+</span>
            </a>
          </aside>
        </div>
      </section>
    </main>

    <SiteFooter />

    <script>
      document.querySelectorAll("[data-contact-form]").forEach((form) => {
        if (!(form instanceof HTMLFormElement)) return;

        const status = form.querySelector("[data-contact-status]");
        const submitButton = form.querySelector("[data-contact-submit]");
        const submitLabel = form.querySelector("[data-contact-submit-label]");
        const turnstileElement = form.querySelector(".cf-turnstile");

        if (
          !(status instanceof HTMLElement) ||
          !(submitButton instanceof HTMLButtonElement) ||
          !(submitLabel instanceof HTMLElement)
        ) {
          return;
        }

        const setStatus = (message: string, state: "idle" | "error" | "success") => {
          status.textContent = message;
          status.dataset.state = state;
        };

        const query = new URLSearchParams(window.location.search);
        if (query.get("sent") === "1") {
          setStatus("Message sent. I’ll get back to you soon.", "success");
          query.delete("sent");
          const nextQuery = query.toString();
          window.history.replaceState(
            {},
            "",
            `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ""}${window.location.hash}`,
          );
        } else if (query.get("error") === "1") {
          setStatus(
            "The message could not be sent. Try again or email hi@traykov.cc.",
            "error",
          );
        }

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          if (!form.reportValidity()) return;

          const data = new FormData(form);
          const turnstileToken = String(data.get("cf-turnstile-response") ?? "");

          if (!turnstileToken) {
            setStatus("Complete the anti-spam check before sending.", "error");
            return;
          }

          submitButton.disabled = true;
          submitLabel.textContent = "Sending…";
          form.setAttribute("aria-busy", "true");
          setStatus("Sending your message…", "idle");

          try {
            const response = await fetch(form.action, {
              method: "POST",
              headers: {
                Accept: "application/json",
                "Content-Type": "application/json",
              },
              body: JSON.stringify(Object.fromEntries(data)),
            });
            const result = (await response.json().catch(() => null)) as {
              error?: string;
              ok?: boolean;
            } | null;

            if (!response.ok || !result?.ok) {
              throw new Error(result?.error || "The message could not be sent.");
            }

            form.reset();
            const turnstile = Reflect.get(window, "turnstile");
            if (turnstileElement && turnstile?.reset) {
              turnstile.reset(turnstileElement);
            }
            setStatus("Message sent. I’ll get back to you soon.", "success");
          } catch (error) {
            setStatus(
              error instanceof Error
                ? error.message
                : "The message could not be sent. Please try again.",
              "error",
            );
          } finally {
            submitButton.disabled = false;
            submitLabel.textContent = "Send message";
            form.removeAttribute("aria-busy");
          }
        });
      });
    </script>
    <SiteAnalytics />
  </body>
</html>
