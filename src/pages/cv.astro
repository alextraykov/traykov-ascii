---
import SiteAnalytics from "../components/SiteAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteNav from "../components/SiteNav.astro";
import { experience } from "../lib/cv";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Alexander Traykov CV — AI Product Designer & UX Lead"
      description="Alexander Traykov’s product design, AI product work, enterprise UX, design systems, and UX leadership experience."
      path="/cv/"
    />
    <script src="/page-transitions.js" defer></script>
  </head>
  <body data-page-type="cv">
    <SiteNav />

    <main id="top" class="notes-index section-shell">
      <section class="notes-hero" aria-labelledby="cv-title" data-reveal="rise" data-reveal-duration="340" data-reveal-page-enter="true">
        <div class="notes-hero__copy">
          <h1 id="cv-title">Experience.</h1>
          <p class="notes-hero__lede">Sofia, Bulgaria · 2014—now.</p>
          <dl>
            <div>
              <dt>Experience</dt>
              <dd>13 years</dd>
            </div>
            <div>
              <dt>Roles</dt>
              <dd>{String(experience.length).padStart(2, "0")}</dd>
            </div>
            <div>
              <dt>Current</dt>
              <dd>Quickbase</dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="experience" class="about-experience" aria-label="Experience">
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-item">
              <div>
                <p>{item.period}</p>
                <h2>{item.company} - {item.role}</h2>
              </div>
              <div>
                <p>{item.body}</p>
                {item.href && (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                    data-ascii-action="secondary"
                    data-ascii-stream
                    data-ascii-burst
                  >
                    Visit
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <SiteFooter />
    <SiteAnalytics />
  </body>
</html>
