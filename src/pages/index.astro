---
import ObjTurntable from "../components/ObjTurntable.astro";
import HomepageTimeline from "../components/HomepageTimeline.astro";
import PrivateWorkLink from "../components/PrivateWorkLink.astro";
import ProjectOverview from "../components/ProjectOverview.astro";
import SiteAnalytics from "../components/SiteAnalytics.astro";
import SiteHead from "../components/SiteHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCaseStudies } from "../lib/content";
import { getHomepageOverviews } from "../lib/homepage-overviews";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";

const homepageOverviews = getHomepageOverviews(getCaseStudies());

const siteUrl = "https://traykov.cc";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: "Alexander Traykov",
    url: siteUrl,
    jobTitle: "Product Designer",
    description:
      "AI product designer and UX lead working across enterprise software, design systems, and design engineering.",
    sameAs: ["https://www.linkedin.com/in/alextraykov/", "https://adplist.org/mentors/alexander-traykov"],
    knowsAbout: [
      "AI product design",
      "Product design leadership",
      "Design systems",
      "Enterprise software",
      "Design engineering",
      "Platform UX"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: "Alexander Traykov Portfolio",
    url: siteUrl,
    author: { "@id": `${siteUrl}/#person` },
    description:
      "Product design case studies by Alexander Traykov across AI app creation, automation, design systems, and enterprise software."
  }
];

---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Product Designer — Alexander Traykov"
      description="Alexander Traykov designs AI products, enterprise software, and design systems from early product questions through shipped interaction detail."
      path="/"
      structuredData={structuredData}
    />
    <script src="/page-transitions.js" defer></script>
  </head>
  <body data-page-type="home">

    <SiteNav active="work" banner />

    <main id="top">
      <section class="about-hero section-shell" aria-labelledby="hero-title">
        <ObjTurntable
          class="about-turntable"
          asciiClass="about-turntable__ascii"
          name="me"
          objSrc="/models/me.glb"
          renderSize={1.06}
          density={5}
          glyphDetail={9}
          brightness={-0.02}
          contrast={1.42}
          hover={0.28}
          click={0.46}
          glow={0.18}
          enableReveal={1}
          revealDuration={1280}
          revealScatter={0.55}
          enableDisperse={1}
          disperse={1}
          magnetism={1}
          disperseRadius={1}
          trailDecay={1}
          enableExplosion={1}
          explosion={1}
          explosionRadius={1}
          ripple={1}
          enableColorClick={0}
          colorClick={1}
          enableColorDisperse={0}
          colorDisperse={1}
          ariaLabel=""
        />

        <div class="about-hero-copy" data-reveal="rise" data-reveal-duration="340" data-reveal-page-enter="true">
          <p class="about-title__prefix" data-scramble data-scramble-trigger="load" data-scramble-duration="260">Alexander Traykov</p>
          <h1 id="hero-title" class="about-title about-title--role">
            Product designer
          </h1>
          <p class="about-hero-lede">
            I design, code and ship software from micro-businesses to large enterprises.
          </p>
        </div>
</section>

      <HomepageTimeline>
        <section id="work" class="work section-shell" aria-labelledby="work-title">
          <!-- Verification contract: Four selected case studies. -->
          <h2 id="work-title" class="visually-hidden">Work</h2>

          <div class="project-overview-list">
            {homepageOverviews.map((overview, index) => (
              <ProjectOverview overview={overview} index={index} />
            ))}
          </div>
          <PrivateWorkLink />
        </section>
      </HomepageTimeline>
    </main>

    <SiteFooter />

    <script>
      import { registerTurntables } from "../scripts/turntable-loader.js";
      import { initializeHomepageTimeline } from "../scripts/homepage-timeline.js";
      import { initializeOverviewVideos } from "../scripts/overview-video.js";

      initializeHomepageTimeline();
      initializeOverviewVideos();

      registerTurntables(
        "[data-obj-turntable]",
        () => import("../scripts/obj-turntable.js"),
        (module, root) => module.initializeObjTurntable(root)
      );
    </script>
    <SiteAnalytics />
  </body>
</html>
