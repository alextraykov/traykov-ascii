---
import SiteAnalytics from "../../components/SiteAnalytics.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHead from "../../components/SiteHead.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

// Round 3: four public tools, each shown by a real screen (scripts/capture-labs-screens.mjs).
// Sketchbook, Rhizome Field and Product Systems Kit stay routable but are not listed.
const labs = [
  {
    id: "playground",
    title: "Turntable Playground",
    description: "Push, lift and scatter the ASCII turntables from the case studies, then copy the settings.",
    href: "/playground/",
    action: "Open the playground",
    tags: ["3D", "Motion", "Controls"]
  },
  {
    id: "svg-ascii-studio",
    title: "SVG → 3D ASCII",
    description: "Drop in a logo, turn it into a spinning ASCII object, pick a look and download it.",
    href: "/svg-ascii-studio/",
    action: "Open the studio",
    tags: ["SVG", "3D", "Export"]
  },
  {
    id: "ascii-banner",
    title: "ASCII Banner Studio",
    description: "Make a moving ASCII banner at the right size for LinkedIn, X, YouTube or your own format, then save it.",
    href: "/labs/ascii-banner/",
    action: "Open banner studio",
    tags: ["Banners", "Patterns", "PNG"],
    // The banner canvas is already dark, so its screen is not inverted in dark mode.
    invert: false
  },
  {
    id: "presenting-in-code",
    title: "Presentations in Code",
    description: "Try camera zooms, live notes and exploded interfaces. Take ten reusable skills.",
    href: "/labs/presenting-in-code/",
    action: "Open the tutorial",
    tags: ["Camera", "Layers", "10 skills"]
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title="Labs — Alexander Traykov"
      description="Public creative-coding tools: an ASCII turntable playground, an SVG to 3D ASCII studio, a banner maker and a tutorial on presenting in code."
      path="/labs/"
    />
    <script src="/page-transitions.js" defer></script>
  </head>
  <body class="labs-page">
    <SiteNav active="labs" />

    <main id="top" class="labs-shell section-shell">
      <section class="labs-hero" data-reveal="rise" data-reveal-duration="340" data-reveal-page-enter="true">
        <div class="labs-hero__copy">
          <h1>Labs</h1>
          <p class="labs-hero__lede">
            {labs.length} tools you can use right now. No signup, and everything you make stays on your computer.
          </p>
        </div>
      </section>

      <section class="labs-directory" aria-labelledby="labs-directory-title">
        <h2 class="visually-hidden" id="labs-directory-title">Available now</h2>
        <ol class="labs-list" data-reveal-group>
          {
            labs.map((lab, index) => (
              <li id={`lab-${lab.id}`} class="labs-item" data-reveal="rise">
                <a class="labs-item__link" href={lab.href}>
                  <span class="labs-item__screen" data-motion-artwork>
                    <img
                      src={`/labs/screens/${lab.id}.webp`}
                      alt=""
                      width="960"
                      height="720"
                      loading={index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      data-screen-invert={lab.invert === false ? "false" : undefined}
                    />
                  </span>
                  <span class="labs-item__copy">
                    <span class="labs-item__title">{lab.title}</span>
                    <span class="labs-item__body">{lab.description}</span>
                  </span>
                  <span class="labs-item__action" aria-hidden="true">Open <span class="labs-item__arrow">→</span></span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </main>

    <SiteFooter />
    <SiteAnalytics />
  </body>
</html>
