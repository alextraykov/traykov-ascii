---
import type { GetStaticPaths } from "astro";
import BlocktypeWavePreview from "../../components/BlocktypeWavePreview.astro";
import SiteAnalytics from "../../components/SiteAnalytics.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHead from "../../components/SiteHead.astro";
import SiteNav from "../../components/SiteNav.astro";
import WebCemeterySketch from "../../components/WebCemeterySketch.astro";
import { getNotes, type NoteRecord } from "../../lib/substack";
import "../../styles/global.css";

type Props = {
  note: NoteRecord;
};

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note }
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props as Props;
const showBlocktypeWavePreview = note.slug === "on-digital-art";
const showWebCemetery = note.visual === "web-cemetery";
const published = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Sofia"
}).format(new Date(note.publishedAt));
const pagePath = `/notes/${note.slug}/`;
const siteUrl = "https://traykov.cc";
const canonicalUrl = new URL(note.canonicalUrl, siteUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonicalUrl}#article`,
    headline: note.title,
    description: note.summary,
    datePublished: note.publishedAt,
    mainEntityOfPage: canonicalUrl,
    ...(note.heroImage ? { image: new URL(note.heroImage, siteUrl).toString() } : {}),
    keywords: note.tags,
    author: { "@id": `${siteUrl}/#person` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumbs`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Notes", item: `${siteUrl}/notes/` },
      { "@type": "ListItem", position: 3, name: note.title, item: canonicalUrl }
    ]
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${note.title} — Alexander Traykov`}
      description={note.summary}
      path={pagePath}
      canonical={canonicalUrl}
      image={note.heroImage}
      imageAlt={note.heroImageAlt ?? note.title}
      ogType="article"
      structuredData={structuredData}
    />
    <script src="/page-transitions.js" defer></script>
  </head>
  <body data-page-type="note">
    <SiteNav active="notes" />

    <main id="top" class="note-page section-shell">
      <nav class="note-page__back" aria-label="Notes">
        <a href="/notes/">← ALL NOTES</a>
      </nav>

      <article>
        <header class="note-header" data-reveal="rise">
          <div class="note-header__meta">
            <span>
              {note.source === "local"
                ? "[PREVIEW]"
                : note.source === "local-published"
                  ? "[PUBLISHED]"
                  : note.source === "legacy"
                    ? "[ARCHIVE]"
                    : "[SYNCED]"}
            </span>
            <time datetime={note.publishedAt}>{published}</time>
            <span>{note.readTime}</span>
          </div>
          <h1>{note.title}</h1>
          {note.tags.length > 0 && (
            <ul aria-label="Topics">
              {note.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        <aside class="authorship-disclaimer" aria-label="Authorship disclaimer" data-reveal="rise">
          <p>This note is AI slop-free and it was written with intent and attention.</p>
        </aside>

        {(note.source === "local" || note.source === "local-published") && note.heroImage && !showWebCemetery && (
          <figure class="note-hero-image" data-reveal="scan">
            <img
              src={note.heroImage}
              alt={note.heroImageAlt ?? ""}
              width="3292"
              height="2436"
              loading="eager"
            />
          </figure>
        )}

        {showWebCemetery && <WebCemeterySketch />}

        {showBlocktypeWavePreview && <BlocktypeWavePreview />}

        <div class="note-body" set:html={note.contentHtml} />

        {note.source !== "local" && (
          <footer class="note-source">
            {note.source === "substack" && note.sourceUrl ? (
              <>
                <span>SOURCE / SUBSTACK</span>
                <a href={note.sourceUrl} target="_blank" rel="noreferrer">
                  ORIGINAL POST ↗
                </a>
              </>
            ) : note.source === "legacy" && note.sourceUrl ? (
              <>
                <span>SOURCE / TRAYKOV.CC ARCHIVE</span>
                <a href={note.sourceUrl} target="_blank" rel="noreferrer">
                  ORIGINAL FILE ↗
                </a>
              </>
            ) : (
              <>
                <span>SOURCE / TRAYKOV.CC</span>
                <span>PUBLISHED LOCALLY</span>
              </>
            )}
          </footer>
        )}
      </article>
    </main>

    <SiteFooter />
    <SiteAnalytics />
  </body>
</html>
