---
import type { GetStaticPaths } from "astro";
import AsciiFlowFieldSketch from "../../components/AsciiFlowFieldSketch.astro";
import BlocktypeWavePreview from "../../components/BlocktypeWavePreview.astro";
import SiteAnalytics from "../../components/SiteAnalytics.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHead from "../../components/SiteHead.astro";
import SiteNav from "../../components/SiteNav.astro";
import { addLocalImageDimensions } from "../../lib/local-image-dimensions";
import PaceLedger from "../../components/PaceLedger.astro";
import PriceOfPaceSketch from "../../components/PriceOfPaceSketch.astro";
import WebCemeterySketch from "../../components/WebCemeterySketch.astro";
import { getNotes, type NoteRecord } from "../../lib/substack";
import "../../styles/global.css";

type Props = {
  note: NoteRecord;
};

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note }
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props as Props;
const showBlocktypeWavePreview = note.slug === "on-digital-art";
const showAsciiFlowField = note.visual === "ascii-flow-field";
const showWebCemetery = note.visual === "web-cemetery";
const showPriceOfPace = note.visual === "price-of-pace";
const published = new Intl.DateTimeFormat("en", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "Europe/Sofia"
}).format(new Date(note.publishedAt));
const pagePath = `/notes/${note.slug}/`;
const siteUrl = "https://traykov.cc";
const canonicalUrl = new URL(note.canonicalUrl, siteUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonicalUrl}#article`,
    headline: note.title,
    description: note.summary,
    datePublished: note.publishedAt,
    mainEntityOfPage: canonicalUrl,
    ...(note.heroImage ? { image: new URL(note.heroImage, siteUrl).toString() } : {}),
    keywords: note.tags,
    author: { "@id": `${siteUrl}/#person` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumbs`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Notes", item: `${siteUrl}/notes/` },
      { "@type": "ListItem", position: 3, name: note.title, item: canonicalUrl }
    ]
  }
];
const noteContentHtml = await addLocalImageDimensions(note.contentHtml);
// Local notes can place a component between paragraphs with a visual block.
const inlineVisuals = { "pace-ledger": PaceLedger } as const;
const noteParts = noteContentHtml
  .split(/<!--note-visual:([a-z-]+)-->/)
  .map((part, index) =>
    index % 2 === 0
      ? { html: part }
      : { Visual: inlineVisuals[part as keyof typeof inlineVisuals] }
  );
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${note.title} — Alexander Traykov`}
      description={note.summary}
      path={pagePath}
      canonical={canonicalUrl}
      image={note.heroImage}
      imageAlt={note.heroImageAlt ?? note.title}
      ogType="article"
      structuredData={structuredData}
    />
    <script src="/page-transitions.js" defer></script>
  </head>
  <body data-page-type="note">
    <SiteNav active="notes" />

    <main id="top" class="note-page section-shell">
      <article>
        <header class="note-header" data-reveal="rise" data-reveal-duration="340" data-reveal-page-enter="true">
          <div class="note-header__utility">
            <nav class="note-page__back" aria-label="Notes">
              <a href="/notes/"><span class="back-link__arrow" aria-hidden="true">←</span> All notes</a>
            </nav>
            <div class="note-header__meta">
              <time datetime={note.publishedAt}>{published}</time>
              <span>{note.readTime}</span>
            </div>
          </div>
          <h1>{note.title}</h1>
        </header>

        {(note.source === "local" || note.source === "local-published") && note.heroImage && !showWebCemetery && (
          <figure class="note-hero-image" data-reveal="scan">
            <img
              src={note.heroImage}
              alt={note.heroImageAlt ?? ""}
              width="3292"
              height="2436"
              loading="eager"
            />
          </figure>
        )}

        {showWebCemetery && <WebCemeterySketch />}

        {showBlocktypeWavePreview && <BlocktypeWavePreview />}

        {showAsciiFlowField && <AsciiFlowFieldSketch />}

        {showPriceOfPace && <PriceOfPaceSketch />}

        <div class="note-body">
          {noteParts.map((part) =>
            "html" in part
              ? <Fragment set:html={part.html} />
              : part.Visual && <part.Visual />
          )}
        </div>

        {note.source !== "local" && (
          <footer class="note-source">
            {note.source === "substack" && note.sourceUrl ? (
              <>
                <span>First published on Substack</span>
                <a href={note.sourceUrl} target="_blank" rel="noreferrer" data-ascii-action="text">
                  Read the original <span aria-hidden="true">↗</span>
                </a>
              </>
            ) : note.source === "legacy" && note.sourceUrl ? (
              <>
                <span>From the traykov.cc archive</span>
                <a href={note.sourceUrl} target="_blank" rel="noreferrer" data-ascii-action="text">
                  Original file <span aria-hidden="true">↗</span>
                </a>
              </>
            ) : (
              <>
                <span>Published on traykov.cc</span>
              </>
            )}
          </footer>
        )}
      </article>
    </main>

    <SiteFooter />
    <SiteAnalytics />
  </body>
</html>
