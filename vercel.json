{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/private-work.js": {
      "includeFiles": ".private-work/**"
    },
    "api/glyph-kit-draw.js": {
      "includeFiles": "skills/glyph-kit/{SKILL.md,reference/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/private",
      "destination": "/api/private-work?action=route&privatePath="
    },
    {
      "source": "/private/",
      "destination": "/api/private-work?action=route&privatePath="
    },
    {
      "source": "/private/:privatePath*",
      "destination": "/api/private-work?action=route&privatePath=:privatePath*"
    },
    {
      "source": "/glyph-kit",
      "destination": "https://glyph-kit-zeta.vercel.app/glyph-kit/"
    },
    {
      "source": "/glyph-kit/",
      "destination": "https://glyph-kit-zeta.vercel.app/glyph-kit/"
    },
    {
      "source": "/glyph-kit/:path*/",
      "destination": "https://glyph-kit-zeta.vercel.app/glyph-kit/:path*/"
    },
    {
      "source": "/glyph-kit/:path*",
      "destination": "https://glyph-kit-zeta.vercel.app/glyph-kit/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/case-studies/pave-blueprint/",
      "destination": "/case-studies/pave-new-look/",
      "permanent": true
    },
    {
      "source": "/case-studies/pave-blueprint",
      "destination": "/case-studies/pave-new-look/",
      "permanent": true
    },
    {
      "source": "/notes/the-cemetery-loop/",
      "destination": "/notes/",
      "permanent": false
    },
    {
      "source": "/notes/the-cemetery-loop",
      "destination": "/notes/",
      "permanent": false
    },
    {
      "source": "/case-studies/",
      "destination": "/#work",
      "permanent": false
    },
    {
      "source": "/case-studies/blinq-pave-rebrand/",
      "destination": "/case-studies/designing-pave/",
      "permanent": true
    },
    {
      "source": "/case-studies/pave-building-loop/",
      "destination": "/case-studies/designing-pave/",
      "permanent": true
    },
    {
